{
  "name": "tarmac-syntax",
  "displayName": "Tarmac Syntax Highlighting",
  "description": "Syntax highlighting para a linguagem Tarmac (beta)",
  "version": "0.1.0",
  "publisher": "gimmelovej",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/gimmelovej/tarmac-syntaxes#readme",
  "bugs": {
    "url": "https://github.com/gimmelovej/tarmac-syntaxes/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gimmelovej/tarmac-syntaxes.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["tarmac", "syntax highlighting", "compiler", "assembly", "beta"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "tarmac",
        "aliases": ["Tarmac", "tarmac"],
        "extensions": [".tm", ".tarmac"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tarmac",
        "scopeName": "source.tarmac",
        "path": "./syntaxes/tarmac.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "vscode-tmgrammar-snap fixtures/*.tm",
    "test:update": "vscode-tmgrammar-snap --updateSnapshot fixtures/*.tm",
    "package": "vsce package",
    "lint:json": "node -e \"['package.json','language-configuration.json','syntaxes/tarmac.tmLanguage.json'].forEach(f=>JSON.parse(require('fs').readFileSync(f,'utf8')));console.log('JSON ok')\""
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
